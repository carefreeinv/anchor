# Anchor: swarm-local profile for Aider + Qwen3 ≤8B (or similar small models).
# Copy this file to `.aider.conf.yml` INSTEAD OF the default `.aider.conf.yml.example`
# when this project's local model is a ≤8B swarm executor. Verified live against
# aider 0.86.2 (2026-09-11): edit-format values "diff"/"whole"/"udiff" are real
# coder names (aider/coders/{editblock,wholefile,udiff}_coder.py); timeout,
# map-tokens, and stream are real config keys, confirmed via a live
# `aider --verbose` config dump against this exact file (below).
#
# Always-on context stays THIN on purpose — a ≤8B model's context budget goes
# to the plan it's executing, not to doctrine. This loads the drone card alone,
# not the fuller AIDER.md brief or the skills-index.md roster (see
# platforms/local-models/qwen3.md's canary note for why).
read:
  - platforms/aider/work-drone.md

# Lighter edit format: full SEARCH/REPLACE diff blocks are easier for a small
# model to produce correctly than a whole-file rewrite on every turn.
edit-format: diff

# Keep the auto repo-map small so it doesn't crowd out the plan being executed.
# GPU-host default. On a CPU-only host (Ollama `/api/ps` shows `size_vram: 0`)
# even 1024 can exceed the timeout on a cold turn -- measured 2026-09 on one
# such WSL2 + Windows-Ollama host: an identical trivial prompt answered in ~72s
# with `map-tokens: 0`, and twice failed to finish in 560s with 1024. Set 0 there.
map-tokens: 1024

# A confused small model should time out in under a minute, not sit on a
# multi-minute retry loop (see the qwen3.md canary: a real session hit 600s).
# GPU-host default. litellm retries a timed-out call, and on a CPU-only host a
# legitimate cold first call can exceed 60s, so raise this there (see the same
# canary note in qwen3.md for the measured cause).
timeout: 60

# Streaming adds overhead for a small local model with no human watching
# tokens arrive turn-by-turn in an unattended/headless drone run. Verified:
# the config file wants the positive key `stream: false`, not `no-stream: true`
# (the latter parses without error but is silently ignored — confirmed via
# `aider --verbose`'s "Option settings" dump, ...stream: True regardless).
stream: false

# Thinking mode is NOT controlled from this file, and typing `/no_think` into
# an Ollama-served Aider session does nothing (Ollama ignores it; measured on
# Ollama 0.34.0 and 0.34.2). The switch that works is the API-level
# `think: false`, which Aider reaches via `reasoning_effort: none` in
# `.aider.model.settings.yml` -- copy
# platforms/aider/.aider.model.settings.yml.example, which also pins `num_ctx`.
# `/no_think` still applies on servers that pass the chat-template suffix
# through (llama.cpp, vLLM); see platforms/local-models/qwen3.md "Thinking toggle".
