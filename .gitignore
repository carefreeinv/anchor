__pycache__/
*.pyc
*.egg-info/
build/
dist/
.venv/
node_modules/
docs/build/
docs/.docusaurus/
orchestration_run.json
benchmark_results.csv
*:Zone.Identifier
var/
# Local secrets — Anchor itself reads ANCHOR_API_KEY / ~/.config/anchor, never a
# .env file; keep any local .env out of the tree so key-shaped values can't be
# committed by accident.
.env
.env.*
!.env.example

# The launcher scripts/aider-ollama.sh is a machine-local copy written by
# /local-models autowire; hardware/personal-devices/configs/ holds the
# tracked template it is copied from.
/scripts/aider-ollama.sh

# Anchor-managed: machine-local Aider config + session artifacts (never commit).
# These replace the broader `.aider*` catch-all main carried (a653cc5): that
# pattern also matched the tracked `platforms/aider/.aider.conf*.yml.example`
# files and a hand-written `.aiderignore`, so a new example could not be
# committed without `-f`. Keeping both was not an option — gitignore has no
# "more specific wins" rule, so the catch-all would have gone on shadowing
# them. The root-anchored `/` entries below cannot shadow anything outside
# the repo root.
/.aider.conf.yml
/.aider.model.settings.yml
.aider.chat.history.md
.aider.input.history
.aider.llm.history
.aider.tags.cache.v*/
