# Copy to .env (gitignored) and fill in. Never commit real keys.

# NVIDIA Build hosted inference — https://build.nvidia.com
NVIDIA_API_KEY=

# Optional fleet-client alias (same value). NVIDIA_API_KEY is enough.
# ANCHOR_API_KEY=

# Aider / local Ollama on this machine (not a secret)
# OLLAMA_API_BASE=http://127.0.0.1:11434
# OPENAI_API_KEY=ollama
